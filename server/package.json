{
  "name": "revivv-api",
  "version": "1.0.0",
  "private": true,
  "description": "Revivv back end: customer accounts, bookings, rewards and the staff console, on PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "admin": "node src/admin.js",
    "test": "node --test --test-concurrency=1 --test-timeout=120000 --test-force-exit \"test/**/*.test.js\"",
    "dev": "node src/dev.js"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "embedded-postgres": "^18.1.0-beta.16"
  }
}
