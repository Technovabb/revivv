# /etc/revivv-api.env: settings for the Revivv API (owner root, group revivv, mode 640).
NODE_ENV=production
HOST=127.0.0.1
PORT=4380
TRUST_PROXY=127.0.0.1
# PostgreSQL on this server, signed in as the revivv system user (no password)
DATABASE_URL=postgresql://revivv@/revivv?host=/var/run/postgresql
SITE_ORIGINS=https://revivvbb.com
SESSION_DAYS=60

# Password-reset emails through Microsoft 365 (docs/BACKEND.md, "Email").
# Until these are filled in and MAIL_MODE=graph, a reset asks the customer to call.
MAIL_MODE=log
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
